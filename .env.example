# ── CORE ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"
# Your own public backend URL, used by the keep-alive self-ping on Render
BACKEND_URL="http://localhost:5000"

# ── DATABASE (MongoDB via Prisma) ───────────────────────────────────────────
DATABASE_URL="mongodb+srv://user:pass@cluster.mongodb.net/invoice-reminder"

# ── AUTH ─────────────────────────────────────────────────────────────────────
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

# ── GOOGLE OAUTH (console.cloud.google.com → APIs & Services → Credentials) ─
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:5000/auth/google/callback"

# ── STRIPE (BILLING) ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_live_xxxx"
# dashboard.stripe.com → Developers → Webhooks → Add endpoint → /webhooks/stripe
STRIPE_WEBHOOK_SECRET="whsec_xxxx"
# The recurring Price for the Pro plan (Product catalog → your Pro product → Pricing)
STRIPE_PRO_PRICE_ID="price_xxxx"
# $5-for-5-weeks intro offer, on the same product — run `npm run setup:trial-price` to create it
STRIPE_TRIAL_PRICE_ID="price_xxxx"

# ── EMAIL (SMTP via Nodemailer) ──────────────────────────────────────────────
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="reminders@yourdomain.com"

# ── TWILIO WHATSAPP (Pro — WhatsApp reminders) ───────────────────────────────
# console.twilio.com — free trial gives you a sandbox WhatsApp number
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="+14155238886"

# ── AI CHAT (OpenRouter) ─────────────────────────────────────────────────────
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openai/gpt-4o-mini"

# ── RENDER (URL of this service itself, used by the keep-alive pinger) ──────
RENDER_SELF_URL=""
