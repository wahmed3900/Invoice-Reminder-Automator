 create mode 100644 src/lib/prisma.js
 create mode 100644 src/lib/stripe.js

diff --git a/.env.example b/.env.example
index 08eaefd..526c786 100644
--- a/.env.example
+++ b/.env.example
@@ -32,6 +32,8 @@ PORT=5000
