+# The recurring Price for the Pro plan (Product catalog → your Pro product → Pricing)
+STRIPE_PRO_PRICE_ID="price_xxxx"
 
 # ── TWILIO WHATSAPP (Pro — WhatsApp reminders) ─────────────────────────────────
 # console.twilio.com — free trial gives you a sandbox WhatsApp number
